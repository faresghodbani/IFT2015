%!PS-Adobe-3.0 EPSF-3.0
%%Title: (test_sierpinski.json)
%%Creator: (lindenmayer.PostScriptRecursive)
%%LanguageLevel: 2
%%BoundingBox: (atend)
%%EndComments
1 setlinecap 1 setlinejoin
/T:draw { newpath 0 0 moveto 1.0 0 lineto stroke 1.0 0 translate } bind def
/T:move { 1.0 0 translate } bind def
/T:turnL { 60.0 rotate } bind def
/T:turnR { -60.0 rotate } bind def
/T:push { gsave } bind def
/T:pop { grestore } bind def
/T:stay { } bind def
/T:choose {
  1 dict begin
    /n exch def
    /limit 2147483647 n idiv n mul def
    {
      /r rand def
      r limit lt { r n mod exit } if
    } loop
  end
} bind def
/S0 {
  dup 0 le { pop T:draw } {
    1 sub 1 dict begin /d exch def
    1 T:choose
    pop
    d S2
    d S3
    d S0
    d S3
    d S2
    end
  } ifelse
} bind def
/S1 {
  pop T:turnL
} bind def
/S2 {
  dup 0 le { pop T:draw } {
    1 sub 1 dict begin /d exch def
    1 T:choose
    pop
    d S0
    d S1
    d S2
    d S1
    d S0
    end
  } ifelse
} bind def
/S3 {
  pop T:turnR
} bind def
gsave
0.0 0.0 translate
0.0 rotate
5 S2
stroke
grestore
%%Trailer
%%BoundingBox: -1 -2 33 29
%%EOF
