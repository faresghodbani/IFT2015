%!PS-Adobe-3.0 EPSF-3.0
%%Title: (test_buisson.json)
%%Creator: (lindenmayer.PostScriptRecursive)
%%LanguageLevel: 2
%%BoundingBox: (atend)
%%EndComments
1 setlinecap 1 setlinejoin
/T:draw { newpath 0 0 moveto 3.0 0 lineto stroke 3.0 0 translate } bind def
/T:move { 3.0 0 translate } bind def
/T:turnL { 22.5 rotate } bind def
/T:turnR { -22.5 rotate } bind def
/T:push { gsave } bind def
/T:pop { grestore } bind def
/T:stay { } bind def
/T:choose {
  1 dict begin
    /n exch def
    /limit 2147483647 n idiv n mul def
    {
      /r rand def
      r limit lt { r n mod exit } if
    } loop
  end
} bind def
/S0 {
  dup 0 le { pop T:draw } {
    1 sub 1 dict begin /d exch def
    1 T:choose
    pop
    d S0
    d S0
    d S4
    d S1
    d S4
    d S0
    d S2
    d S0
    d S2
    d S0
    d S3
    d S2
    d S1
    d S2
    d S0
    d S4
    d S0
    d S4
    d S0
    d S3
    end
  } ifelse
} bind def
/S1 {
  pop T:push
} bind def
/S2 {
  pop T:turnL
} bind def
/S3 {
  pop T:pop
} bind def
/S4 {
  pop T:turnR
} bind def
gsave
250.0 0.0 translate
90.0 rotate
5 S0
stroke
grestore
%%Trailer
